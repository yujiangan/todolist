{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "lib": ["es2020"],
    "types": ["node"]
  },
  "include": ["src/**/*"]
}