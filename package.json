{
  "name": "todolist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "src"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm run dev -w @todolist/frontend",
    "dev:backend": "npm run dev -w @todolist/backend",
    "build": "npm-run-all --serial build:frontend build:backend",
    "build:frontend": "npm run build -w @todolist/frontend",
    "build:backend": "npm run build -w @todolist/backend",
    "lint": "npm run lint -w @todolist/frontend && npm run lint -w @todolist/backend",
    "lint:fix": "npm run lint:fix -w @todolist/frontend && npm run lint:fix -w @todolist/backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.2.2"
  }
}
